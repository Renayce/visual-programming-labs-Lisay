    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const subject = item.json.subject || \"Без темы\";\n  const from = item.json.from || \"Неизвестно\";\n  const snippet = item.json.snippet || \"\";\n  const id = item.json.id || \"unknown\";\n  \n  // Формируем содержимое текстового файла\n  const fileContent = `Тема письма: ${subject}\\n\\nОт кого: ${from}\\n\\nКраткое содержание: ${snippet}\\n\\nСсылка на письмо: https://mail.google.com/mail/u/0/#inbox/${id}`;\n  \n  // Кодируем в base64 используя btoa (работает в любом JS окружении)\n  const base64Data = btoa(unescape(encodeURIComponent(fileContent)));\n  \n  results.push({\n    json: { fileName: `Email_${id}.txt` },\n    binary: {\n      data: {\n        data: base64Data,\n        mimeType: 'text/plain',\n        fileName: `Email_${id}.txt`\n      }\n    }\n  });\n}\n\nreturn results;"
      },
